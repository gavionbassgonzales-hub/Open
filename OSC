-- UI helpers
-- ============================================================
local function round(inst, r)
    local c = Instance.new("UICorner"); c.CornerRadius = UDim.new(0, r); c.Parent = inst
end
local function stroke(inst, color, thickness)
    local s = Instance.new("UIStroke")
    s.Color = color; s.Thickness = thickness or 1
    s.ApplyStrokeMode = Enum.ApplyStrokeMode.Border; s.Parent = inst
end
local function newScreenGui(name, order)
    local g = Instance.new("ScreenGui")
    g.Name = name
    g.ResetOnSpawn = false; g.IgnoreGuiInset = true
    g.DisplayOrder = order or 999; g.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    local ok = pcall(function()
        if typeof(gethui) ~= "function" then error("no gethui") end
        g.Parent = gethui()
    end)
    if not (ok and g.Parent) then ok = pcall(function() g.Parent = game:GetService("CoreGui") end) end
    if not (ok and g.Parent) then g.Parent = LocalPlayer:WaitForChild("PlayerGui") end
    return g
end
local function makeButton(parent, text, pos, size, color)
    local b = Instance.new("TextButton")
    b.Size = size; b.Position = pos
    b.BackgroundColor3 = color
    b.BorderSizePixel = 0
    b.Text = text
    b.TextColor3 = Color3.new(1, 1, 1)
    b.Font = Enum.Font.GothamBold; b.TextSize = 14
    b.AutoButtonColor = true
    b.Parent = parent
    round(b, 10)
    return b
end

-- ============================================================
-- GUARD MODULE (schematic-aware, auto-restore tampered parts)
-- ============================================================
local Guard = {
    enabled  = true,
    suppress = false,
    hold     = 0,        -- os.clock() until which events are ignored (replication lag)
    alive    = true,
    remote   = nil,
    parts    = {},       -- [part] = snapshot {cf,size,color,material,transp,collide}
    queue    = {},
    replaced = nil,      -- callback(old, new) when a deleted part is recreated
}
local guardAttach

local function guardActive()
    return Guard.enabled and not Guard.suppress and os.clock() > Guard.hold
end

local function setGuard(on)
    Guard.enabled = on
    if not on then Guard.queue = {} end
end

local function guardApplyProps(remote, new, snap)
    remote:InvokeServer("SyncResize",   {{Part = new, Size = snap.size, CFrame = snap.cf}})
    remote:InvokeServer("SyncColor",    {{Part = new, Color = snap.color, UnionColoring = false}})
    remote:InvokeServer("SyncMaterial", {{Part = new, Material = snap.material, Transparency = snap.transp}})
    if not snap.collide then pcall(function() remote:InvokeServer("SyncCollision", {{Part = new, CanCollide = false}}) end) end
    remote:InvokeServer("SyncAnchor",   {{Part = new, Anchored = true}})
end

local function guardRestoreBatch(batch)
    local remote = Guard.remote
    if not remote then return end
    local mv, rs, cl, mt, an, cc = {}, {}, {}, {}, {}, {}
    for _, part in ipairs(batch) do
        local snap = Guard.parts[part]
        if snap then
            if part.Parent then
                mv[#mv + 1] = {Part = part, CFrame = snap.cf}
                rs[#rs + 1] = {Part = part, Size = snap.size, CFrame = snap.cf}
                cl[#cl + 1] = {Part = part, Color = snap.color, UnionColoring = false}
                mt[#mt + 1] = {Part = part, Material = snap.material, Transparency = snap.transp}
                an[#an + 1] = {Part = part, Anchored = true}
                if not snap.collide then cc[#cc + 1] = {Part = part, CanCollide = false} end
            else
                local ok, new = pcall(function()
                    return remote:InvokeServer("CreatePart", "Normal", snap.cf, workspace)
                end)
                if ok and new then
                    pcall(guardApplyProps, remote, new, snap)
                    Guard.parts[new] = snap
                    Guard.parts[part] = nil
                    guardAttach(new)
                    if Guard.replaced then pcall(Guard.replaced, part, new) end
                    dbg("recreated deleted part")
                end
            end
        end
    end
    if #mv > 0 then
        pcall(function() remote:InvokeServer("SyncMove",     mv) end)
        pcall(function() remote:InvokeServer("SyncResize",   rs) end)
        pcall(function() remote:InvokeServer("SyncColor",    cl) end)
        pcall(function() remote:InvokeServer("SyncMaterial", mt) end)
        if #cc > 0 then pcall(function() remote:InvokeServer("SyncCollision", cc) end) end
        pcall(function() remote:InvokeServer("SyncAnchor",   an) end)
    end
end

guardAttach = function(part)
    part:GetPropertyChangedSignal("CFrame"):Connect(function()
        local s = Guard.parts[part]
        if s and (part.CFrame.Position - s.cf.Position).Magnitude > 0.1 and guardActive() then
            Guard.queue[part] = true
        end
    end)
    part:GetPropertyChangedSignal("Size"):Connect(function()
        local s = Guard.parts[part]
        if s and (part.Size - s.size).Magnitude > 0.05 and guardActive() then
            Guard.queue[part] = true
        end
    end)
    part:GetPropertyChangedSignal("Color"):Connect(function()
        local s = Guard.parts[part]
        if s and part.Color ~= s.color and guardActive() then
            Guard.queue[part] = true
        end
    end)
    part:GetPropertyChangedSignal("Anchored"):Connect(function()
        if not part.Anchored and Guard.parts[part] and guardActive() then
            Guard.queue[part] = true
        end
    end)
    part.AncestryChanged:Connect(function(_, parent)
        if parent == nil and Guard.parts[part] and guardActive() then
            Guard.queue[part] = true
        end
    end)
end

task.spawn(function()
    while Guard.alive do
        task.wait(0.15)
        if not Guard.enabled then
            Guard.queue = {}
        else
            local batch = {}
            for p in pairs(Guard.queue) do
                batch[#batch + 1] = p
                if #batch >= 40 then break end
            end
            for _, p in ipairs(batch) do Guard.queue[p] = nil end
            if #batch > 0 then pcall(guardRestoreBatch, batch) end
        end
    end
end)

