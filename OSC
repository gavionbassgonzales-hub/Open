local function fireStrike(target)
    print("[OSC MK4] fireStrike called, target =", target)

    if _G.OSC and _G.OSC.FullFire then
        print("[OSC MK4] triggering cannon animation")
        task.spawn(function() _G.OSC:FullFire() end)
    else
        warn("[OSC MK4] _G.OSC missing - cannon animation skipped")
    end

    if strike then
        if strike.conn then strike.conn:Disconnect() end
        if strike.folder then strike.folder:Destroy() end
        strike = nil
    end
    clearServerMirror()
    local haveF3X = ensureF3XReady()
    local haveHD  = ensureHDReady()

    local S, T = CFG.STUDS_PER_BLOCK, CFG.TNT_FUSE
    local G, D = CFG.GRAVITY, CFG.DRAG
    local TICK = 1 / CFG.TPS
    local height = CFG.OFFSET_HEIGHT or fallAfter(T)
    local origin = target + Vector3.new(0, height * S, 0)
    local cube = CFG.TNT_CUBE * S

    local folder = Instance.new("Folder")
    folder.Name = "Strike"; folder.Parent = getRoot()

    local X, Y, Z, VX, VY, VZ = {}, {}, {}, {}, {}, {}
    local PX, PY, PZ = {}, {}, {}
    local parts, N = {}, 0

    local function addTNT(vx, vz)
        N = N + 1
        X[N], Y[N], Z[N] = 0, 0, 0
        PX[N], PY[N], PZ[N] = 0, 0, 0
        VX[N], VY[N], VZ[N] = vx, 0, vz
        local p = Instance.new("Part")
        p.Anchored = true; p.CanCollide = false; p.CanTouch = false
        p.CanQuery = false; p.CastShadow = false; p.Locked = true
        p.Material = Enum.Material.SmoothPlastic
        p.Color = RED
        p.Size = Vector3.new(cube, cube, cube)
        p.CFrame = CFrame.new(origin + Vector3.new(0, 0.5 * S, 0))
        p.Parent = folder
        parts[N] = p
    end

    if CFG.CENTER_CHARGE then addTNT(0, 0) end
    for _, ring in ipairs(buildLayout()) do
        local speed = launchSpeed(ring.radius, T)
        for j = 0, ring.count - 1 do
            local a = (2 * math.pi * j) / ring.count
            local k = 1 + (math.random() * 2 - 1) * (CFG.IMPERFECTION_PERCENT / 100)
            addTNT(math.cos(a) * speed * k, math.sin(a) * speed * k)
        end
    end
    print(("[OSC MK4] local TNT parts created: %d"):format(N))

    if haveF3X and CFG.F3X_MAX_PARTS > 0 and N > CFG.F3X_MAX_PARTS then
        local step = N / CFG.F3X_MAX_PARTS
        local nextKeep = 1
        local keepSet = {}
        for i = 1, N do
            if i >= nextKeep then keepSet[i] = true; nextKeep = nextKeep + step end
        end
        for i = 1, N do if not keepSet[i] then parts[i]:Destroy() end end
        local nParts, nX, nY, nZ = {}, {}, {}, {}
        local nVX, nVY, nVZ = {}, {}, {}
        local nPX, nPY, nPZ = {}, {}, {}
        local m = 0
        for i = 1, N do
            if keepSet[i] then
                m = m + 1
                nParts[m] = parts[i]
                nX[m], nY[m], nZ[m]    = X[i], Y[i], Z[i]
                nVX[m], nVY[m], nVZ[m] = VX[i], VY[i], VZ[i]
                nPX[m], nPY[m], nPZ[m] = PX[i] or 0, PY[i] or 0, PZ[i] or 0
            end
        end
        parts = nParts; X, Y, Z = nX, nY, nZ
        VX, VY, VZ = nVX, nVY, nVZ
        PX, PY, PZ = nPX, nPY, nPZ
        N = m
    end

    task.spawn(function()
        local ok, err = spawnServerMirror(parts)
        if ok then dbg("F3X mirror OK: "..tostring(err))
        else dbgw("F3X mirror FAILED: "..tostring(err)) end
    end)

    local age, accum = 0, 0
    local flashWhite = nil
    local cfs = {}
    local conn
    local syncAccum = 0
    local syncDt = 1 / math.max(1, CFG.F3X_SYNC_HZ)

    local function step()
        age = age + 1
        for i = 1, N do
            PX[i], PY[i], PZ[i] = X[i], Y[i], Z[i]
            local vy = VY[i] - G
            X[i] = X[i] + VX[i]; Y[i] = Y[i] + vy; Z[i] = Z[i] + VZ[i]
            VX[i] = VX[i] * D; VY[i] = vy * D; VZ[i] = VZ[i] * D
        end
    end

    local function render(alpha)
        local fuse = T - age
        local fuseF = fuse - alpha
        local white = (math.floor(fuse / 5) % 2 == 0)
        if white ~= flashWhite then
            flashWhite = white
            local c = white and WHITE or RED
            for i = 1, N do parts[i].Color = c end
        end
        local q = 1 - (fuseF + 1) / 10
        if q > 0 then
            if q > 1 then q = 1 end
            q = q * q * q * q
            local e = cube * (1 + 0.3 * q)
            local sz = Vector3.new(e, e, e)
            for i = 1, N do parts[i].Size = sz end
        end
        for i = 1, N do
            local x = PX[i] + (X[i] - PX[i]) * alpha
            local y = PY[i] + (Y[i] - PY[i]) * alpha
            local z = PZ[i] + (Z[i] - PZ[i]) * alpha
            cfs[i] = CFrame.new(origin.X + x * S, origin.Y + (y + 0.5) * S, origin.Z + z * S)
        end
        local ok = pcall(Workspace.BulkMoveTo, Workspace, parts, cfs, Enum.BulkMoveMode.FireCFrameChanged)
        if not ok then for i = 1, N do parts[i].CFrame = cfs[i] end end
    end

    local function detonate()
        local blasts = table.create(N)
        for i = 1, N do
            blasts[i] = Vector3.new(origin.X + X[i]*S, origin.Y + (Y[i]+0.5)*S, origin.Z + Z[i]*S)
        end
        local stride = math.max(1, math.ceil(N / CFG.EXPLOSION_VISUALS))
        for i = 1, N, stride do
            local ex = Instance.new("Explosion")
            ex.BlastPressure = 0
            ex.BlastRadius = math.min(100, 4 * S)
            ex.DestroyJointRadiusPercent = 0
            ex.ExplosionType = Enum.ExplosionType.NoCraters
            ex.Position = blasts[i]
            ex.Parent = folder
        end
        task.spawn(function()
            local hitPlayers = collectHitPlayers(blasts)
            if #hitPlayers == 0 then return end
            local ok, result = fireHDOnPlayers(hitPlayers)
            if ok then dbg("HD OK: "..tostring(result))
            else dbgw("HD FAIL: "..tostring(result)) end
        end)
        for i = 1, N do parts[i]:Destroy() end
        if strike and strike.conn == conn then strike = nil end
        task.delay(6, function() if folder and folder.Parent then folder:Destroy() end end)
        F3XState.removeThread = task.delay(CFG.F3X_REMOVE_DELAY, function()
            F3XState.removeThread = nil
            clearServerMirror()
        end)
    end

    print("[OSC MK4] starting heartbeat")
    render(0)
    conn = RunService.Heartbeat:Connect(function(dt)
        accum = math.min(accum + dt, TICK * 6)
        while accum >= TICK do
            accum = accum - TICK
            step()
            if age >= T then conn:Disconnect(); detonate(); return end
        end
        render(accum / TICK)
        if CFG.F3X_LIVE_SYNC then
            syncAccum = syncAccum + dt
            if syncAccum >= syncDt then
                syncAccum = 0
                pushServerFrame()
            end
        end
    end)
    strike = { conn = conn, folder = folder }
end

local function doFire()
    local target = getTarget()
    if not target then say("No target - aim at the ground"); return end
    pcall(function()
        if LocalPlayer.CameraMaxZoomDistance < 800 then LocalPlayer.CameraMaxZoomDistance = 800 end
    end)
    fireStrike(target)
    local tags = {}
    if F3XState.ready and CFG.ENABLE_F3X_SYNC then tags[#tags+1] = "F3X" end
    if HDState.ready and CFG.ENABLE_HD_SYNC then tags[#tags+1] = "HD" end
    say(#tags > 0 and ("MK4 launched ("..table.concat(tags,"+").." synced)") or "MK4 launched (local only)")
end

