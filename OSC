        local hasH = HDState.ready and CFG.ENABLE_HD_SYNC
        dotRef.BackgroundColor3    = hasH and Color3.fromRGB(56,189,248) or Color3.fromRGB(230,80,80)
        f3xDotRef.BackgroundColor3 = hasF and Color3.fromRGB(255,150,40) or Color3.fromRGB(160,80,255)
        local sub = {}
        if hasF then sub[#sub+1] = "F3X" end
        if hasH then sub[#sub+1] = "HD" end
        subRef.Text = (#sub > 0) and ("sync: "..table.concat(sub,"+")) or "no sync"
        subRef.TextColor3 = TEXT_DIM
    end
    refreshFireButton()

    makeToggle(panel, "Crosshair", 104,
        function() return crosshairOn end,
        function() setCrosshair(not crosshairOn); say(crosshairOn and "Crosshair ON" or "OFF") end)
    makeToggle(panel, "F3X / Fork3X / BTools", 140,
        function() return CFG.ENABLE_F3X_SYNC end,
        function()
            CFG.ENABLE_F3X_SYNC = not CFG.ENABLE_F3X_SYNC
            if CFG.ENABLE_F3X_SYNC then ensureF3XReady() end
            refreshFireButton()
        end)
    makeToggle(panel, "HD / Admin / Mod", 176,
        function() return CFG.ENABLE_HD_SYNC end,
        function()
            CFG.ENABLE_HD_SYNC = not CFG.ENABLE_HD_SYNC
            if CFG.ENABLE_HD_SYNC then ensureHDReady() end
            refreshFireButton()
        end)
    makeToggle(panel, "Auto-Repair", 212,
        function() return Guard.enabled end,
        function() setGuard(not Guard.enabled); say(Guard.enabled and "Guard ON" or "Guard OFF") end)

    local clearBtn = Instance.new("TextButton")
    clearBtn.Size = UDim2.new(1, -20, 0, 32); clearBtn.Position = UDim2.new(0, 10, 0, 252)
    clearBtn.BackgroundColor3 = BTN_IDLE; clearBtn.BorderSizePixel = 0
    clearBtn.Text = "CLEAR"; clearBtn.TextColor3 = TEXT_MAIN
    clearBtn.Font = Enum.Font.GothamMedium; clearBtn.TextSize = 13
    clearBtn.Parent = panel; round(clearBtn, 8); stroke(clearBtn, Color3.fromRGB(48,53,66), 1)

    local removeCannonBtn = Instance.new("TextButton")
    removeCannonBtn.Size = UDim2.new(1, -20, 0, 32); removeCannonBtn.Position = UDim2.new(0, 10, 0, 290)
    removeCannonBtn.BackgroundColor3 = Color3.fromRGB(120, 50, 60); removeCannonBtn.BorderSizePixel = 0
    removeCannonBtn.Text = "REMOVE CANNON"; removeCannonBtn.TextColor3 = Color3.fromRGB(255, 200, 200)
    removeCannonBtn.Font = Enum.Font.GothamMedium; removeCannonBtn.TextSize = 12
    removeCannonBtn.Parent = panel; round(removeCannonBtn, 8); stroke(removeCannonBtn, Color3.fromRGB(150,70,80), 1)

    local diagBtn = Instance.new("TextButton")
    diagBtn.Size = UDim2.new(1, -20, 0, 26); diagBtn.Position = UDim2.new(0, 10, 0, 328)
    diagBtn.BackgroundColor3 = Color3.fromRGB(40,48,60); diagBtn.BorderSizePixel = 0
    diagBtn.Text = "DIAGNOSE"; diagBtn.TextColor3 = Color3.fromRGB(200,210,230)
    diagBtn.Font = Enum.Font.GothamMedium; diagBtn.TextSize = 11
    diagBtn.Parent = panel; round(diagBtn, 6); stroke(diagBtn, Color3.fromRGB(60,68,84), 1)

    statusLabel = Instance.new("TextLabel")
    statusLabel.Size = UDim2.new(1, -20, 0, 46); statusLabel.Position = UDim2.new(0, 10, 0, 360)
    statusLabel.BackgroundTransparency = 1
    statusLabel.Text = "Aim, then press G to fire"
    statusLabel.TextColor3 = TEXT_DIM; statusLabel.Font = Enum.Font.Gotham
    statusLabel.TextSize = 11; statusLabel.TextWrapped = true
    statusLabel.TextXAlignment = Enum.TextXAlignment.Left
    statusLabel.TextYAlignment = Enum.TextYAlignment.Top
    statusLabel.Parent = panel

    fireBtn.Activated:Connect(doFire)
    clearBtn.Activated:Connect(function()
        clearServerMirror()
        if strike then
            if strike.conn then strike.conn:Disconnect() end
            if strike.folder then strike.folder:Destroy() end
            strike = nil
        end
        say("Cleared")
    end)
    removeCannonBtn.Activated:Connect(function()
        task.spawn(function()
            local ok, okRes, result = pcall(CannonBuilder.remove, function(msg) say(msg) end)
            say((ok and okRes) and tostring(result) or ("Remove failed: " .. tostring((ok and result) or okRes)))
        end)
    end)
    closeBtn.Activated:Connect(function() destroyAll() end)

    diagBtn.Activated:Connect(function()
        print("============ OSC MK4 DIAGNOSTIC ============")
        print("F3X tool:", getF3XTool())
        print("F3X endpoint:", ep())
        print("HD signal:", hdSignal)
        print("Guard enabled:", Guard.enabled, "| tracked parts:", (function()
            local n = 0; for _ in pairs(Guard.parts) do n = n + 1 end; return n
        end)())
        print("Built parts:", #built.parts)
        print("===========================================")
        say("Diagnostics printed")
    end)

    local dragging, dragStart, startPos, moved = false, nil, nil, false
    panel.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1
            or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true; moved = false; dragStart = input.Position; startPos = panel.Position
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then dragging = false end
            end)
        end
    end)
    conns[#conns+1] = UserInputService.InputChanged:Connect(function(input)
        if not dragging then return end
        if input.UserInputType == Enum.UserInputType.MouseMovement
            or input.UserInputType == Enum.UserInputType.Touch then
            local d = input.Position - dragStart
            if not moved and math.abs(d.X) + math.abs(d.Y) > 4 then moved = true end
            if moved then
                panel.Position = UDim2.new(
                    startPos.X.Scale, startPos.X.Offset + d.X,
                    startPos.Y.Scale, startPos.Y.Offset + d.Y)
            end
        end
    end)
    conns[#conns+1] = UserInputService.InputBegan:Connect(function(input, processed)
        if processed then return end
        if input.KeyCode == CFG.KEYBIND then doFire() end
    end)
end

-- ============================================================
-- DESTROY
-- ============================================================
destroyAll = function()
    Guard.alive = false
    Guard.enabled = false
    task.spawn(function() pcall(CannonBuilder.remove) end)
    clearServerMirror()
    if strike then
        if strike.conn then strike.conn:Disconnect() end
        if strike.folder then strike.folder:Destroy() end
        strike = nil
    end
    if fxRoot then fxRoot:Destroy(); fxRoot = nil end
    for _, c in ipairs(conns) do pcall(function() c:Disconnect() end) end
    conns = {}
    if gui then gui:Destroy(); gui = nil end
    if crosshairGui then crosshairGui:Destroy(); crosshairGui = nil end
    if buildGuiRef then buildGuiRef:Destroy(); buildGuiRef = nil end
    ENV.OSC_MK4 = nil
end

