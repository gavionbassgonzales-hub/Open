local function buildLayout()
    local rings, n = {}, CFG.RING_COUNT
    for i = 1, n do
        local r = CFG.FIRST_RADIUS + (i - 1) * CFG.RADIUS_STEP
        if i <= n / 2 then r = r * CFG.INNER_RING_MULTIPLIER
        else r = r * CFG.OUTER_RING_MULTIPLIER end
        local count
        if CFG.RING_COUNTS and CFG.RING_COUNTS[i] then count = CFG.RING_COUNTS[i]
        else
            local t = (n > 1) and ((i - 1) / (n - 1)) or 0
            count = math.floor(CFG.MIN_PER_RING + (CFG.MAX_PER_RING - CFG.MIN_PER_RING) * t + 0.5)
        end
        rings[i] = { radius = r, count = count }
    end
    return rings
end

local function fallAfter(ticks)
    local vy, y = 0, 0
    for _ = 1, ticks do vy = vy - CFG.GRAVITY; y = y + vy; vy = vy * CFG.DRAG end
    return -y
end

local function launchSpeed(radius, ticks)
    local d = CFG.DRAG
    return radius * (1 - d) / (1 - d ^ ticks)
end

local function getRoot()
    if not (fxRoot and fxRoot.Parent) then
        fxRoot = Instance.new("Folder"); fxRoot.Name = "OSC_MK4_FX"; fxRoot.Parent = Workspace
    end
    return fxRoot
end

local function say(msg) if statusLabel then statusLabel.Text = msg end end

local function getTarget()
    local cam = Workspace.CurrentCamera
    if not cam then return nil end
    local vp = cam.ViewportSize
    local ray = cam:ViewportPointToRay(vp.X / 2, vp.Y / 2)
    local params = RaycastParams.new()
    params.FilterType = Enum.RaycastFilterType.Exclude
    local ignore = { getRoot() }
    if LocalPlayer.Character then ignore[#ignore + 1] = LocalPlayer.Character end
    params.FilterDescendantsInstances = ignore
    local hit = Workspace:Raycast(ray.Origin, ray.Direction.Unit * CFG.MAX_RANGE, params)
    return hit and hit.Position or nil
end

local function getF3XTool()
    for _, v in ipairs(LocalPlayer:GetDescendants()) do
        if v.Name == "SyncAPI" and v.Parent then return v.Parent end
    end
    local bp = LocalPlayer:FindFirstChildOfClass("Backpack")
    if bp then
        for _, v in ipairs(bp:GetChildren()) do
            if v:FindFirstChild("SyncAPI") then return v end
        end
    end
    local char = LocalPlayer.Character
    if char then
        for _, v in ipairs(char:GetChildren()) do
            if v:FindFirstChild("SyncAPI") then return v end
        end
    end
    for _, v in ipairs(ReplicatedStorage:GetDescendants()) do
        if v.Name == "SyncAPI" then return v.Parent end
    end
    return nil
end

local function ep()
    local t = getF3XTool()
    if not t then return nil end
    local ok, endpoint = pcall(function() return t.SyncAPI.ServerEndpoint end)
    if not ok or endpoint == nil then return nil end
    return endpoint
end

local function api(a)
    local e = ep()
    if not e then return false end
    return pcall(function() e:InvokeServer(unpack(a)) end)
end

local function apiChunked(cmd, changes)
    if not changes or #changes == 0 then return end
    local step = CFG.F3X_SYNC_CHUNK_SIZE or 80
    local i = 1
    while i <= #changes do
        local chunk = {}
        local j = 0
        while j < step and i <= #changes do j = j + 1; chunk[j] = changes[i]; i = i + 1 end
        api({cmd, chunk})
        if i <= #changes then task.wait(CFG.F3X_CHUNK_DELAY or 0.06) end
    end
end

local hdSignal = nil
local function initHD()
    local client = ReplicatedStorage:FindFirstChild("HDAdminHDClient")
    if not client then client = ReplicatedStorage:FindFirstChild("HDAdminClient") end
    if not client then return false end
    local signals = client:FindFirstChild("Signals")
    if not signals then return false end
    local sig = signals:FindFirstChild("RequestCommandSilent")
    if not sig then sig = signals:FindFirstChild("RequestCommand") end
    if not sig then return false end
    hdSignal = sig; return true
end
local function requestHD(cmd)
    if not hdSignal or not hdSignal.Parent then
        if not initHD() then return false end
    end
    pcall(function() hdSignal:InvokeServer(cmd) end)
    return true
end

local F3XState = { ready=false, label=nil, pairs=nil, busy=false, removeThread=nil }
local HDState = { ready=false, label=nil }

local function ensureF3XReady()
    local e = ep()
    if e then
        if not F3XState.ready then
            F3XState.ready = true
            F3XState.label = "F3X SyncAPI.ServerEndpoint"
            dbg("F3X ready")
            refreshFireButton()
        end
        return true
    end
    if F3XState.ready then F3XState.ready = false; refreshFireButton() end
    return false
end

local function ensureHDReady()
    if initHD() then
        if not HDState.ready then
            HDState.ready = true
            HDState.label = "HDAdmin"
            dbg("HD ready")
            refreshFireButton()
        end
        return true
    end
    if HDState.ready then HDState.ready = false; refreshFireButton() end
    return false
end

local function clearServerMirror()
    if F3XState.removeThread then
        pcall(function() task.cancel(F3XState.removeThread) end)
        F3XState.removeThread = nil
    end
    local pairsList = F3XState.pairs
    F3XState.pairs = nil
    if pairsList and #pairsList > 0 and ep() then
        local parts = {}
        for i, pr in ipairs(pairsList) do parts[i] = pr.part end
        task.spawn(function() pcall(function() api({"Remove", parts}) end) end)
    end
end

local function spawnServerMirror(localParts)
    local e = ep()
    if not e then return false, "no F3X endpoint" end
    if #localParts == 0 then return false, "no local parts" end
    local n = #localParts
    if CFG.F3X_MAX_PARTS > 0 and n > CFG.F3X_MAX_PARTS then n = CFG.F3X_MAX_PARTS end
    local indices = table.create(n)
    if n == #localParts then
        for i = 1, n do indices[i] = i end
    else
        for i = 1, n do indices[i] = math.floor((i - 0.5) * #localParts / n) + 1 end
    end
    local existing = {}
    for _, c in ipairs(Workspace:GetChildren()) do existing[c] = true end
    local BATCH = 40
    for i = 1, n, BATCH do
        for j = i, math.min(i + BATCH - 1, n) do
            local cf = localParts[indices[j]].CFrame
            task.spawn(function() api({"CreatePart", "Normal", cf, Workspace}) end)
        end
        task.wait(0.05)
    end
    local start = tick()
    local collected = {}
    while tick() - start < CFG.F3X_CREATE_WAIT do
        collected = {}
        for _, c in ipairs(Workspace:GetChildren()) do
            if c:IsA("BasePart") and not existing[c] then table.insert(collected, c) end
        end
        if #collected >= n then break end
        task.wait(0.1)
    end
    if #collected == 0 then return false, "0 parts appeared" end
    local used = {}
    local pairsList = {}
    local cellSize = 8
    local grid = {}
    local function key(v) return math.floor(v.X/cellSize)..","..math.floor(v.Y/cellSize)..","..math.floor(v.Z/cellSize) end
    for i, idx in ipairs(indices) do
        local pos = localParts[idx].CFrame.Position
        local k = key(pos)
        if not grid[k] then grid[k] = {} end
        grid[k][#grid[k]+1] = i
    end
    for _, sp in ipairs(collected) do
        local p = sp.Position
        local bestI = nil
        local cx, cy, cz = math.floor(p.X/cellSize), math.floor(p.Y/cellSize), math.floor(p.Z/cellSize)
        for dx = -1, 1 do for dy = -1, 1 do for dz = -1, 1 do
            local k = (cx+dx)..","..(cy+dy)..","..(cz+dz)
            local bucket = grid[k]
            if bucket then
                for _, i in ipairs(bucket) do
                    if not used[i] then bestI = bestI or i; break end
                end
            end
        end end end
        if not bestI then for i = 1, n do if not used[i] then bestI = i; break end end end
        if bestI then
            used[bestI] = true
            pairsList[#pairsList + 1] = { part = sp, target = localParts[indices[bestI]] }
        end
    end
    local moveC, resizeC, colorC, matC, anchorC, collideC, nameC = {}, {}, {}, {}, {}, {}, {}
    for i, pr in ipairs(pairsList) do
        local sp, lp = pr.part, pr.target
        moveC[i]    = { ["Part"] = sp, ["CFrame"] = lp.CFrame }
        resizeC[i]  = { ["Part"] = sp, ["Size"] = lp.Size, ["CFrame"] = lp.CFrame }
        colorC[i]   = { ["Part"] = sp, ["Color"] = lp.Color }
        matC[i]     = { ["Part"] = sp, ["Material"] = lp.Material }
        anchorC[i]  = { ["Part"] = sp, ["Anchored"] = true }
        collideC[i] = { ["Part"] = sp, ["CanCollide"] = false }
        nameC[i]    = sp
    end
    task.spawn(function()
        task.wait(0.35)
        local nameStep = CFG.F3X_SYNC_CHUNK_SIZE or 80
        do
            local i = 1
            while i <= #nameC do
                local chunk = {}
                for j = 1, nameStep do
                    if i + j - 1 > #nameC then break end
                    chunk[j] = nameC[i + j - 1]
                end
                pcall(function() api({"SetName", chunk, "OSC_TNT"}) end)
                i = i + nameStep
                if i <= #nameC then task.wait(CFG.F3X_CHUNK_DELAY or 0.06) end
            end
        end
        apiChunked("SyncMove", moveC)
        apiChunked("SyncResize", resizeC)
        apiChunked("SyncColor", colorC)
        task.wait(0.15)
        apiChunked("SyncColor", colorC)
        apiChunked("SyncMaterial", matC)
        apiChunked("SyncAnchor", anchorC)
        apiChunked("SyncCollision", collideC)
        task.wait(0.4)
        local stragglers = {}
        for _, pr in ipairs(pairsList) do
            local sp = pr.part
            if sp and sp.Parent and sp.Color then
                local c = sp.Color
                local isGrey = math.abs(c.R-0.639)<0.02 and math.abs(c.G-0.635)<0.02 and math.abs(c.B-0.647)<0.02
                if isGrey then
                    stragglers[#stragglers+1] = { ["Part"] = sp, ["Color"] = pr.target.Color }
                end
            end
        end
        if #stragglers > 0 then
            dbg("color verification found "..#stragglers.." grey parts")
            apiChunked("SyncColor", stragglers)
            task.wait(0.2)
            apiChunked("SyncColor", stragglers)
        end
    end)
    F3XState.pairs = pairsList
    return true, string.format("%d server parts", #pairsList)
end

local function pushServerFrame()
    local pairsList = F3XState.pairs
    if not pairsList or #pairsList == 0 then return end
    if F3XState.busy then return end
    F3XState.busy = true
    local changes = table.create(#pairsList)
    for i, pr in ipairs(pairsList) do
        changes[i] = { ["Part"] = pr.part, ["CFrame"] = pr.target.CFrame }
    end
    task.spawn(function()
        apiChunked("SyncMove", changes)
        F3XState.busy = false
    end)
end

local function collectHitPlayers(blasts)
    local hit = {}
    local r2 = CFG.HD_BLAST_RADIUS * CFG.HD_BLAST_RADIUS
    for _, plr in ipairs(Players:GetPlayers()) do
        if plr ~= LocalPlayer or CFG.HD_INCLUDE_SELF then
            local char = plr.Character
            if char then
                local hrp = char:FindFirstChild("HumanoidRootPart")
                local hum = char:FindFirstChildOfClass("Humanoid")
                if hrp and hum and hum.Health > 0 then
                    local pos = hrp.Position
                    for i = 1, #blasts do
                        local d = pos - blasts[i]
                        if d:Dot(d) <= r2 then hit[#hit+1] = plr; break end
                    end
                end
            end
        end
    end
    return hit
end

local function fireHDOnPlayers(hitPlayers)
    if not CFG.ENABLE_HD_SYNC then return false, "HD disabled" end
    if not ensureHDReady() then return false, "HD signal missing" end
    if #hitPlayers == 0 then return false, "no players" end
    task.spawn(function()
        for _, plr in ipairs(hitPlayers) do
            local name = plr.Name
            if CFG.HD_EXPLODE then requestHD(";explode " .. name); task.wait(CFG.HD_PER_PLAYER_DELAY) end
            if CFG.HD_DAMAGE_AFTER then requestHD(";damage " .. name .. " " .. CFG.HD_DAMAGE); task.wait(CFG.HD_PER_PLAYER_DELAY) end
        end
        if CFG.HD_HEAL_AFTER then
            task.wait(0.3)
            for _, plr in ipairs(hitPlayers) do
                requestHD(";heal " .. plr.Name .. " " .. CFG.HD_HEAL_AMOUNT)
                task.wait(CFG.HD_PER_PLAYER_DELAY)
            end
        end
    end)
    return true, string.format("%d targeted", #hitPlayers)
end

